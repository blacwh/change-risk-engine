{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@change-risk/cli": ["./apps/cli/src/index.ts"],
      "@change-risk/config": ["./packages/config/src/index.ts"],
      "@change-risk/core": ["./packages/core/src/index.ts"],
      "@change-risk/coverage": ["./packages/coverage/src/index.ts"],
      "@change-risk/dependency-graph": [
        "./packages/dependency-graph/src/index.ts"
      ],
      "@change-risk/git-adapter": ["./packages/git-adapter/src/index.ts"],
      "@change-risk/language-typescript": [
        "./packages/language-typescript/src/index.ts"
      ],
      "@change-risk/ownership": ["./packages/ownership/src/index.ts"],
      "@change-risk/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"],
      "@change-risk/reporters": ["./packages/reporters/src/index.ts"],
      "@change-risk/rules": ["./packages/rules/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
